cabal-version:      2.4
name:               zadanie1-web
version:            0.1.0.0
build-type:         Simple

executable zadanie1-web
  main-is:          Main.hs
  hs-source-dirs:   app, src
  default-language: Haskell2010
  ghc-options:      -Wall

  build-depends:
      base >=4.14 && <5
    , scotty ^>= 0.22
    , aeson
    , text
